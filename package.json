{
  "name": "hypertorrent",
  "version": "1.0.0",
  "description": "Ultra high-speed BitTorrent download engine & glassmorphic desktop app",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server/index.js",
    "desktop": "electron .",
    "desktop:dev": "electron .",
    "build:exe": "electron-builder --win",
    "build:portable": "electron-builder --win portable"
  },
  "keywords": [
    "torrent",
    "bittorrent",
    "downloader",
    "webtorrent",
    "turbo-boost",
    "electron"
  ],
  "author": "HyperTorrent",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "webtorrent": "^3.0.21",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.hypertorrent.desktop",
    "productName": "HyperTorrent",
    "npmRebuild": false,
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "server/**/*",
      "public/**/*",
      "electron/**/*",
      "package.json"
    ],
    "protocols": [
      {
        "name": "BitTorrent Magnet Link",
        "schemes": [
          "magnet"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HyperTorrent"
    }
  }
}
